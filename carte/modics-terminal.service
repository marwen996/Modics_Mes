# Installation sur le Pi :
#   sudo cp modics-terminal.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now modics-terminal
# Logs : journalctl -u modics-terminal -f   et   /home/pi/Downloads/modics.log
# Si le terminal est déjà lancé par autostart (rc.local, ~/.config/autostart, crontab @reboot), le retirer
# pour éviter deux instances. Adapter WorkingDirectory/ExecStart au dossier réel de moul.py.
[Unit]
Description=MODICS terminal (moul.py + API OF port 8080)
After=network-online.target graphical.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Downloads
Environment=DISPLAY=:0
ExecStart=/usr/bin/python3 /home/pi/Downloads/moul.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
